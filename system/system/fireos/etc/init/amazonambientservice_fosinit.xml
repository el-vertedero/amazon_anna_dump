<fosinit xmlns="http://www.amazon.com"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.amazon.com/fireos/base/core/config/ fosinit.xsd">
    <vendor-services>
        <service impl="com.amazon.ambient.service.AmbientManagerService" />
    </vendor-services>
    <vendor-managers>
        <manager name="amazonambientservice"
            base="com.amazon.ambient.service.AmbientManager"
            fetcher="CACHED" />
    </vendor-managers>
    <vendor-callbacks>
        <callback base="com.android.server.power.VendorPowerManagerCallback"
            impl="com.amazon.ambient.service.AmbientPowerManagerCallback"
            classLoader="SYSTEMSERVER" />
        <callback base="com.android.server.VendorSystemServiceManagerCallback"
            impl="com.amazon.ambient.service.AmbientSystemServerCallback"
            classLoader="SYSTEMSERVER" />
    </vendor-callbacks>
</fosinit>
